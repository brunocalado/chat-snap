<div class="chat-snap-pdf-wrapper">
  <div class="chat-snap-pdf-toolbar">
    <a class="chat-snap-pdf-new-tab" href="{{src}}" target="_blank" rel="noopener noreferrer">
      <i class="fa-solid fa-arrow-up-right-from-square"></i> Open in new tab
    </a>
  </div>
  <object data="{{src}}" type="application/pdf" class="chat-snap-pdf-frame">
    <div class="chat-snap-pdf-fallback">
      <p>Your browser could not display this PDF inline.</p>
      <a href="{{src}}" target="_blank" rel="noopener noreferrer">Open in new tab</a>
    </div>
  </object>
</div>
