<form class="flexcol" autocomplete="off">
  <div class="storage-section">
    <h3>Upload Limits</h3>
    <div class="form-group">
      <label for="maxFileSizeMb">Max File Size (MB)</label>
      <input type="number" id="maxFileSizeMb" name="maxFileSizeMb"
             value="{{maxFileSizeMb}}" min="1" max="1000" step="1">
      <p class="hint">Applies to players only — GMs can upload files of any size. Range: 1–1000 MB.</p>
    </div>
  </div>

  <div class="storage-section">
    <h3>Storage Usage</h3>
    <div class="flexrow storage-usage-row">
      <button type="button" data-action="checkUsage">
        <i class="fa-solid fa-magnifying-glass-chart"></i> Check Usage
      </button>
      <span class="storage-check-result">
        {{#if lastCheckLabel}}
          Usage: <strong>{{lastCheckLabel}}</strong> &nbsp;|&nbsp; Last Check: {{lastCheckDate}}
        {{else}}
          —
        {{/if}}
      </span>
    </div>
    <p class="hint">
      This reflects the total size of files physically stored on the server in the upload folder.
      Clearing the chat log does <strong>not</strong> delete these files — they remain on disk until
      removed manually via the Foundry file browser or your hosting control panel.
    </p>
  </div>

  <div class="storage-section">
    <h3>Chat Log</h3>
    <p class="chat-log-stat">
      <i class="fa-solid fa-comments"></i>
      <strong>{{chatMessageCount}}</strong> messages &nbsp;·&nbsp; ~<strong>{{chatSizeLabel}}</strong> in memory
    </p>
    <p class="hint">
      The entire chat log is sent to every player each time they join the session. More messages
      means higher memory usage and longer connection times for everyone. If loading feels slow,
      consider clearing old messages via Foundry's built-in chat controls.
    </p>
  </div>

  <div class="form-footer flexrow">
    <button type="button" data-action="save">
      <i class="fa-solid fa-floppy-disk"></i> Save
    </button>
  </div>
</form>
