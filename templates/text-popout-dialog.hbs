<div class="chat-snap-text-wrapper">
  <div class="chat-snap-text-toolbar">
    <a class="chat-snap-text-new-tab" href="{{src}}" target="_blank" rel="noopener noreferrer">
      <i class="fa-solid fa-arrow-up-right-from-square"></i> Open in new tab
    </a>
  </div>
  <pre class="chat-snap-text-content{{#if isJson}} chat-snap-text-json{{/if}}">{{content}}</pre>
</div>
